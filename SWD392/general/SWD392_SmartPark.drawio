<diagram name="3-State Diagram" id="state"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="SMARTPARK — STATE DIAGRAM: ParkingTicket lifecycle" style="text;html=1;fontStyle=1;fontSize=20;align=left;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="i" value="" style="shape=ellipse;perimeter=ellipsePerimeter;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="488" y="80" width="24" height="24" as="geometry"/></mxCell><mxCell id="Active" value="Active" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="160" height="50" as="geometry"/></mxCell><mxCell id="PayPending" value="PaymentPending" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="290" width="160" height="50" as="geometry"/></mxCell><mxCell id="Paid" value="Paid" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="160" height="50" as="geometry"/></mxCell><mxCell id="Closed" value="Closed" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="570" width="160" height="50" as="geometry"/></mxCell><mxCell id="f1" value="" style="html=1;fillColor=#000000;strokeColor=#000000;shape=endState;" vertex="1" parent="1"><mxGeometry x="485" y="700" width="30" height="30" as="geometry"/></mxCell><mxCell id="PayFailed" value="PaymentFailed" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="290" width="170" height="50" as="geometry"/></mxCell><mxCell id="Cancelled" value="Cancelled" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="150" width="160" height="50" as="geometry"/></mxCell><mxCell id="f2" value="" style="html=1;fillColor=#000000;strokeColor=#000000;shape=endState;" vertex="1" parent="1"><mxGeometry x="185" y="270" width="30" height="30" as="geometry"/></mxCell><mxCell id="e11" value="generateTicket" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="i" target="Active"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="arriveAtExit / calculateFee" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Active" target="PayPending"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="paymentSuccess" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PayPending" target="Paid"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="paymentFail" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;verticalAlign=bottom;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PayPending" target="PayFailed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="retryPayment" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;verticalAlign=top;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PayFailed" target="PayPending"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="openExitGate / releaseSlot" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Paid" target="Closed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Closed" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="cancelTicket" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="Active" target="Cancelled"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Cancelled" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n3" value="BRIEF EXPLANATION&#10;• Initial → Active when the ticket is generated at entry; final states: Closed (normal) and Cancelled (alternative).&#10;• Main path: Active → PaymentPending → Paid → Closed.&#10;• Branch: paymentFail moves to PaymentFailed and retryPayment returns to PaymentPending; cancelTicket leads to Cancelled. 9 labelled transitions." style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#ffffff;strokeColor=#82b366;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="430" width="520" height="124" as="geometry"/></mxCell></root></mxGraphModel></diagram>
