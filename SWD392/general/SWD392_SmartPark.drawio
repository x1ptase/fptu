dge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="636" as="sourcePoint"/><mxPoint x="934" y="636" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m25" value="true" style="html=1;verticalAlign=bottom;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="934" y="680" as="sourcePoint"/><mxPoint x="546" y="680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m26" value="8: create(vehicle, slot, entryTime)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="724" as="sourcePoint"/><mxPoint x="1734" y="724" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m27" value="ticket" style="html=1;verticalAlign=bottom;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1734" y="768" as="sourcePoint"/><mxPoint x="546" y="768" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m28" value="9: save(ticket)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="546" y="812" as="sourcePoint"/><mxPoint x="1134" y="812" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m29" value="true" style="html=1;verticalAlign=bottom;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1134" y="856" as="sourcePoint"/><mxPoint x="546" y="856" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m30" value="ticket" style="html=1;verticalAlign=bottom;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="534" y="900" as="sourcePoint"/><mxPoint x="346" y="900" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m31" value="open gate + print ticket" style="html=1;verticalAlign=bottom;endArrow=open;endSize=10;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="33