        <mxCell id="q_m5" value="5: add(reg)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="456" y="1490" as="sourcePoint"/><mxPoint x="940" y="1490" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="q_m5r" value="saved" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="940" y="1525" as="sourcePoint"/><mxPoint x="456" y="1525" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="q_m6" value="6: registration confirmed" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="444" y="1560" as="sourcePoint"/><mxPoint x="221" y="1560" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="q_div2" value="" style="line;strokeWidth=1;dashed=1;html=1;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="365" y="1590" width="960" height="8" as="geometry"/></mxCell>
        <mxCell id="q_div2c" value="[currentCount &gt;= capacity]  event full" style="text;html=1;fontStyle=1;fontColor=#B85450;align=left;" vertex="1" parent="1"><mxGeometry x="420" y="1598" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="q_m7" value="7: reject - Event is full" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="444" y="1625" as="sourcePoint"/><mxPoint x="221" y="1625" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="q_div1" value="" style="line;strokeWidth=1;dashed=1;html=1;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="345" y="1680" width="1000" height="8" as="geometry"/></mxCell>
        <mxCell id="q_div1c" value="[event.isOpen() == false]  event closed" style="text;html=1;fontStyle=1;fontColor=#B85450;align=left;" vertex="1" parent="1"><mxGeometry x="400" y="1688" width="360" height="20" as="geometry"/></mxCell>
        <mxCell id="q_m8" value="8: reject - Registration closed" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="444" y="1725" as="sourcePoint"/><mxPoint x="221" y="1725" as="targetPoint"/></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3-State Diagram" id="state">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="stt" value="STATE DIAGRAM — TEMPLATE" style="text;html=1;fontStyle=1;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="600" height="30" as="geometry"/></mxCell>

        <mxCell id="i" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="308" y="80" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="s1" value="State1&#10;(Draft)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="150" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="s2" value="State2&#10;(Approved / Open)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="290" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="s3" value="State3&#10;(Ongoing)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="430" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="s4" value="State4&#10;(Completed)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="240" y="570" width="160" height="55" as="geometry"/></mxCell>
        <mxCell id="salt" value="AltState&#10;(Cancelled / Rejected)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="170" height="55" as="geometry"/></mxCell>
        <mxCell id="f1" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;shape=endState;" vertex="1" parent="1"><mxGeometry x="305" y="700" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="f2" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;shape=endState;" vertex="1" parent="1"><mxGeometry x="630" y="420" width="30" height="30" as="geometry"/></mxCell>

        <mxCell id="ts0" value="submitEvent" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="i" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ts1" value="triggerEvent [guard]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ts2" value="triggerEvent" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ts3" value="triggerEvent" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ts4" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="s4" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ts5" value="cancelEvent (nhánh rẽ)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2" target="salt"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ts6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="salt" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="sthint" value="GỢI Ý STATE DIAGRAM (vòng đời 1 đối tượng, vd Event):&#10;&#10;• Bắt buộc có: 1 initial state (chấm đen ●) và ≥1 final state (chấm đen có vòng ◉).&#10;• State = danh từ/tính từ mô tả trạng thái: Draft, Approved, Ongoing, Completed...&#10;• Transition = mũi tên liền có tên EVENT kích hoạt: submitEvent, approveEvent, startEvent, finishEvent, cancelEvent.&#10;• Guard [điều kiện] ghi sau tên event khi transition chỉ xảy ra nếu thỏa: registerParticipant [capacity reached].&#10;• Internal transition (lặp không đổi state): ghi thẳng trong box, vd &quot;registerParticipant [slot free] / addParticipant&quot;.&#10;• Nhánh rẽ (branching): ít nhất 1 đường tới trạng thái kết thúc thay thế — Cancelled / Rejected.&#10;&#10;KHI ĐỌC ĐỀ: mỗi câu &quot;event goes to state X when Y happens&quot; = 1 transition. Đếm đủ số transition đề yêu cầu (đề EMS: ≥ 6)." style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=none;strokeColor=#d6b656;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="470" width="740" height="320" as="geometry"/></mxCell>

        <mxCell id="stex" value="VÍ DỤ MẪU (đề EMS — vòng đời Event):&#10;&#10;● (initial)&#10;  --submitEvent--&gt; Draft&#10;  --approveEvent--&gt; Approved&#10;  --openRegistration--&gt; OpenForRegistration&#10;       (internal: registerParticipant [slot free] / addParticipant)&#10;  --registerParticipant [capacity reached]--&gt; Full&#10;  --startEvent--&gt; Ongoing&#10;  --finishEvent--&gt; Completed --&gt; ◉ (final)&#10;&#10;Nhánh rẽ (branching):&#10;  Draft --rejectEvent [not approved]--&gt; Rejected --&gt; ◉&#10;  Approved / OpenForRegistration --cancelEvent--&gt; Cancelled --&gt; ◉&#10;&#10;Đủ ≥ 6 transition: submitEvent, approveEvent, openRegistration, registerParticipant, startEvent, finishEvent, cancelEvent." style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=none;strokeColor=#82b366;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="80" width="740" height="360" as="geometry"/></mxCell>

        <mxCell id="p_lbl" value="▼ DIAGRAM EMS HOÀN CHỈNH (mẫu đã điền — vòng đời Event):" style="text;html=1;fontStyle=1;fontSize=15;align=left;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="800" height="30" as="geometry"/></mxCell>

        <mxCell id="p_init" value="" style="ellipse;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="588" y="880" width="24" height="24" as="geometry"/></mxCell>
        <mxCell id="p_Draft" value="Draft" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="960" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="p_Approved" value="Approved" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="1110" width="160" height="50" as="geometry"/></mxCell>
        <mxCell id="p_Open" value="OpenForRegistration&#10;&#10;registerParticipant [slot free] / addParticipant" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=none;fontStyle=1;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="490" y="1260" width="220" height="80" as="geometry"/></mxCell>
