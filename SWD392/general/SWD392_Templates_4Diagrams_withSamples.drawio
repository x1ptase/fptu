        <mxCell id="shint" value="GỢI Ý SEQUENCE DIAGRAM:&#10;&#10;THỨ TỰ CỘT (trái → phải theo Layered): Actor → UI/Boundary → Controller/Service → Repository → Entity.&#10;&#10;LOẠI MŨI TÊN:&#10;• Nét liền, đầu đặc → synchronous call (gọi hàm, chờ kết quả). Ghi tên method: findById(), save()...&#10;• Nét đứt, đầu mở → return value (giá trị trả về).&#10;&#10;ACTIVATION BAR: thanh chữ nhật mỏng trên lifeline = object đang xử lý. Service thường có bar dài nhất.&#10;&#10;alt FRAGMENT — khi đề có &quot;if... otherwise&quot; / &quot;whether... or&quot;:&#10;• Mỗi nhánh 1 ngăn, ghi guard trong ngoặc vuông [điều kiện] ở góc trái trên.&#10;• Ngăn cách bằng ĐƯỜNG NGANG ĐỨT NÉT (không mũi tên).&#10;• Đề EMS: alt [event open]/[closed], alt [capacity available]/[full].&#10;&#10;REPOSITORY PATTERN phải HIỆN RÕ: gọi thẳng findById(), countByEvent(), add() — không &quot;tự truy&quot; dữ liệu." style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=none;strokeColor=#d6b656;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="80" width="440" height="470" as="geometry"/></mxCell>

        <mxCell id="sex" value="VÍ DỤ MẪU (đề EMS — Use case: Register for Event):&#10;&#10;Cột: Student → :StudentPortal → :RegistrationService → :EventRepository / :RegistrationRepository → event:Event&#10;&#10;1: register(userId, eventId)         (Student → Portal → Service)&#10;2: findById(eventId) → event         (Service → EventRepository)   ← Repository Pattern&#10;alt [event.isOpen() == true]&#10;   3: countByEvent(eventId) → currentCount   (Service → RegistrationRepository)&#10;   alt [currentCount &lt; capacity]&#10;      4: create Registration(...) → reg&#10;      5: add(reg) → saved&#10;      6: registration confirmed   (→ Portal)&#10;   else [currentCount &gt;= capacity]&#10;      7: reject &quot;Event is full&quot;&#10;else [event.isOpen() == false]&#10;   8: reject &quot;Registration closed&quot;&#10;&#10;Mẹo: 2 chữ &quot;whether... whether...&quot; trong đề = 2 khung alt (open/closed + available/full)." style="text;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=8;fillColor=none;strokeColor=#82b366;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1120" y="580" width="440" height="380" as="geometry"/></mxCell>

        <mxCell id="q_lbl" value="▼ DIAGRAM EMS HOÀN CHỈNH (mẫu đã điền — Register for Event):" style="text;html=1;fontStyle=1;fontSize=15;align=left;fontColor=#2E7D32;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="800" height="30" as="geometry"/></mxCell>

        <mxCell id="q_actor" value="Student" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;" vertex="1" parent="1"><mxGeometry x="50" y="1060" width="30" height="60" as="geometry"/></mxCell>
        <mxCell id="q_l1" value=":StudentPortal" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;collapsible=0;fillColor=none;size=40;" vertex="1" parent="1"><mxGeometry x="140" y="1060" width="150" height="760" as="geometry"/></mxCell>
        <mxCell id="q_l2" value=":RegistrationService" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;collapsible=0;fillColor=none;size=40;" vertex="1" parent="1"><mxGeometry x="360" y="1060" width="180" height="760" as="geometry"/></mxCell>
        <mxCell id="q_l3" value=":EventRepository" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;collapsible=0;fillColor=none;size=40;" vertex="1" parent="1"><mxGeometry x="620" y="1060" width="160" height="760" as="geometry"/></mxCell>
        <mxCell id="q_l4" value=":RegistrationRepository" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;collapsible=0;fillColor=none;size=40;" vertex="1" parent="1"><mxGeometry x="850" y="1060" width="200" height="760" as="geometry"/></mxCell>
        <mxCell id="q_l5" value="event:Event / reg:Registration" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;container=1;collapsible=0;fillColor=none;size=40;" vertex="1" parent="1"><mxGeometry x="1120" y="1060" width="220" height="760" as="geometry"/></mxCell>

        <mxCell id="q_a1" value="" style="html=1;points=[];fillColor=none;strokeColor=#000000;" vertex="1" parent="q_l2"><mxGeometry x="84" y="80" width="12" height="500" as="geometry"/></mxCell>
        <mxCell id="q_au" value="" style="html=1;points=[];fillColor=none;strokeColor=#000000;" vertex="1" parent="q_l1"><mxGeometry x="69" y="80" width="12" height="470" as="geometry"/></mxCell>

        <mxCell id="q_m1" value="1: register(userId, eventId)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="221" y="1150" as="sourcePoint"/><mxPoint x="444" y="1150" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="q_m2" value="2: findById(eventId)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="456" y="1200" as="sourcePoint"/><mxPoint x="700" y="1200" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="q_m2r" value="event" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="1235" as="sourcePoint"/><mxPoint x="456" y="1235" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="q_alt1" value="alt" style="shape=umlFrame;html=1;width=40;height=24;fillColor=none;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="345" y="1270" width="1000" height="490" as="geometry"/></mxCell>
        <mxCell id="q_alt1c" value="[event.isOpen() == true]" style="text;html=1;fontStyle=1;fontColor=#B85450;align=left;" vertex="1" parent="1"><mxGeometry x="400" y="1273" width="240" height="20" as="geometry"/></mxCell>
        <mxCell id="q_m3" value="3: countByEvent(eventId)" style="html=1;verticalAlign=bottom;endArrow=block;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="456" y="1320" as="sourcePoint"/><mxPoint x="940" y="1320" as="targetPoint"/></mxGeometry></mxCell>
